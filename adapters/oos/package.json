{
  "name": "@topo/oos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context-filter": {
      "types": "./dist/context-filter.d.ts",
      "default": "./dist/context-filter.js"
    },
    "./local-client": {
      "types": "./dist/local-client.d.ts",
      "default": "./dist/local-client.js"
    },
    "./remote-client": {
      "types": "./dist/remote-client.d.ts",
      "default": "./dist/remote-client.js"
    },
    "./remote-gateway": {
      "types": "./dist/remote-gateway.d.ts",
      "default": "./dist/remote-gateway.js"
    },
    "./remote-relay": {
      "types": "./dist/remote-relay.d.ts",
      "default": "./dist/remote-relay.js"
    },
    "./remote-relay-http": {
      "types": "./dist/remote-relay-http.d.ts",
      "default": "./dist/remote-relay-http.js"
    },
    "./remote-relay-device": {
      "types": "./dist/remote-relay-device.d.ts",
      "default": "./dist/remote-relay-device.js"
    },
    "./remote-relay-session": {
      "types": "./dist/remote-relay-session.d.ts",
      "default": "./dist/remote-relay-session.js"
    },
    "./remote-device-registry": {
      "types": "./dist/remote-device-registry.d.ts",
      "default": "./dist/remote-device-registry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@topo/schemas": "0.1.0",
    "@topo/store": "0.1.0"
  }
}
