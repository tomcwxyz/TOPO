# Private single-person alpha only; additional deployment access protection required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
TOPO_ALPHA_PASSWORD=use-a-unique-passphrase-at-least-16-chars
TOPO_SESSION_SECRET=replace-with-a-cryptographically-random-32-plus-character-secret
# Optional agent integration: SHA-256 hex of a randomly generated 32+ character bearer token.
TOPO_AGENT_TOKEN_SHA256=
# Optional cron secret for daily expired-source deletion (required for cloud/cron).
CRON_SECRET=
