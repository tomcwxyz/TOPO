{
  "name": "@topo/formats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory-markdown": {
      "types": "./dist/memoryMarkdown.d.ts",
      "default": "./dist/memoryMarkdown.js"
    },
    "./portable-bundle": {
      "types": "./dist/portableBundle.d.ts",
      "default": "./dist/portableBundle.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@topo/schemas": "0.1.0",
    "@topo/store": "0.1.0"
  }
}
